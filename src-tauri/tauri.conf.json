{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoolerScreen",
  "mainBinaryName": "CoolerScreen",
  "version": "4.19.0",
  "identifier": "com.oldbugo.coolerscreen",
  "build": {
    "frontendDist": "../public",
    "beforeBuildCommand": "cargo build --release --manifest-path src-tauri/Cargo.toml --bin cs2"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "shortDescription": "Put your own videos on the Lovingcool SC70 cooler screen",
    "copyright": "MIT License",
    "resources": {
      "../node_modules/ffmpeg-static/ffmpeg.exe": "ffmpeg.exe",
      "../scripts/setup-winusb.ps1": "scripts/setup-winusb.ps1",
      "../scripts/restore-serial.ps1": "scripts/restore-serial.ps1",
      "../scripts/reconnect.ps1": "scripts/reconnect.ps1"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
