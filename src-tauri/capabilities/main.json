{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Window chrome and the core commands for the app pages (local).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-win-minimize",
    "allow-win-toggle-maximize",
    "allow-win-state",
    "allow-win-close",
    "allow-win-force-close",
    "allow-live-set",
    "allow-app-state",
    "allow-settings-update",
    "allow-activity",
    "allow-job-get",
    "allow-job-cancel",
    "allow-set-focus",
    "allow-originals-list",
    "allow-import-bytes",
    "allow-import-path",
    "allow-missing-delete",
    "allow-original-get",
    "allow-original-patch",
    "allow-original-delete",
    "allow-original-reveal",
    "allow-estimate",
    "allow-loop-search",
    "allow-loop-point",
    "allow-version-create",
    "allow-version-patch",
    "allow-version-delete",
    "allow-version-send",
    "allow-version-remake",
    "allow-version-retry",
    "allow-sources-list",
    "allow-browse-set",
    "allow-link-add",
    "allow-source-set",
    "allow-source-items",
    "allow-source-add",
    "allow-gallery-set-dir",
    "allow-gallery-open",
    "allow-gallery-sync",
    "allow-device-state",
    "allow-device-check",
    "allow-device-restart",
    "allow-device-setup",
    "allow-device-restore",
    "allow-device-reconnect",
    "allow-theme-get",
    "allow-theme-set",
    "allow-theme-standard",
    "allow-theme-preview",
    "allow-theme-asset-add",
    "allow-theme-apply",
    "allow-theme-use",
    "allow-theme-set-base",
    "allow-calibration-set",
    "allow-fit-cal",
    "allow-weather-search",
    "allow-weather-set-place",
    "allow-ext-sensor-status",
    "allow-screen-preview",
    "allow-screen-preview-end",
    "allow-twin-watch"
