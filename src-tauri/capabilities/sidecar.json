{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "sidecar",
  "description": "Window chrome only for the Node sidecar page served on 127.0.0.1 (COOLERSCREEN_BACKEND=node).",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-win-minimize",
    "allow-win-toggle-maximize",
    "allow-win-state",
    "allow-win-close",
    "allow-win-force-close"
  ]
}
