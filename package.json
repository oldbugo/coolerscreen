{
  "name": "coolerscreen",
  "version": "1.1.0",
  "description": "Unofficial open-source tool to put your own videos/GIFs/images on the Lovingcool SC70 AIO cooler USB screen",
  "main": "electron/main.js",
  "scripts": {
    "start": "node bin/serve.js",
    "cli": "node bin/coolerscreen.js",
    "app": "electron electron/main.js"
  },
  "keywords": [
    "lovingcool",
    "sc70",
    "aio-cooler",
    "usb-screen",
    "winusb",
    "ffmpeg"
  ],
  "author": "oldbugo",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "serialport": "^12.0.0",
    "usb": "^2.19.1"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "@serialport/bindings-cpp@12.0.1": true,
    "usb@2.19.1": true,
    "electron@44.7.0": true
  },
  "bin": {
    "coolerscreen": "bin/coolerscreen.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oldbugo/coolerscreen.git"
  },
  "homepage": "https://github.com/oldbugo/coolerscreen#readme",
  "bugs": {
    "url": "https://github.com/oldbugo/coolerscreen/issues"
  },
  "files": [
    "bin",
    "src",
    "public",
    "scripts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "electron"
  ],
  "devDependencies": {
    "electron": "^44.7.0"
  }
}
