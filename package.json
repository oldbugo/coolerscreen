{
  "name": "coolerscreen",
  "version": "4.21.1",
  "private": true,
  "description": "Unofficial open-source tool to put your own videos/GIFs/images on the Lovingcool SC70 AIO cooler USB screen",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/make-release.ps1"
  },
  "keywords": [
    "lovingcool",
    "sc70",
    "aio-cooler",
    "usb-screen",
    "winusb",
    "ffmpeg",
    "tauri"
  ],
  "author": "oldbugo",
  "license": "MIT",
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oldbugo/coolerscreen.git"
  },
  "homepage": "https://github.com/oldbugo/coolerscreen#readme",
  "bugs": {
    "url": "https://github.com/oldbugo/coolerscreen/issues"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "ffmpeg-static": "^5.3.0"
  }
}
